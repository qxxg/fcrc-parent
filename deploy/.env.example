# 复制为 .env 后按服务器实际情况修改。不要提交真实密码到版本库。

# 镜像标签：部署脚本会使用它给镜像打 tag，回滚时可指定上一个 tag。
IMAGE_TAG=1.0.0

# 对外端口
WEB_PORT=8088
GATEWAY_PORT=8080
MYSQL_HOST_PORT=3306
NACOS_HTTP_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_CONSOLE_PORT=8849

# MySQL
MYSQL_DATABASE=fcrc
MYSQL_USER=fcrc
MYSQL_PASSWORD=fcrc_pass
MYSQL_ROOT_PASSWORD=fcrc_root_pass

# Nacos
NACOS_VERSION=v3.0.3
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=security
NACOS_AUTH_TOKEN=SecretKey012345678901234567890123456789012345678901234567890123456789

# 演示数据：首次启动时写入客户/风险/合规/案件/报告样例。
# 生产环境务必设为 false，并清空已有演示数据。
FCRC_DEMO_DATA_ENABLED=true

# AI 模型：mock 零依赖；dashscope 需要真实 API Key。
FCRC_AGENT_MODEL=mock
FCRC_DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_API_KEY=
FCRC_AGENT_SANDBOX=false
