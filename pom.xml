<?xml version="1.0" encoding="UTF-8"?>
<!--
  金融合规与风控平台（FCRC）根工程。

  设计说明（教学重点）：
  1. 使用 Spring Boot 3.5.x + Spring Cloud 2025.0.x + Spring Cloud Alibaba 2025.x，
     与 Nacos 3.x 客户端配套，保证企业环境中的长期可维护性。
  2. 所有业务服务共享 fcrc-service-parent，统一依赖版本、测试插件与打包方式。
  3. 版本号集中在此处维护，子模块不得硬编码依赖版本，避免"依赖漂移"。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.fcrc</groupId>
    <artifactId>fcrc-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>FCRC - Financial Compliance &amp; Risk Control Platform</name>
    <description>面向金融合规与风险控制场景的企业级教学平台</description>

    <modules>
        <module>fcrc-common</module>
        <module>fcrc-service-parent</module>
        <module>fcrc-gateway</module>
        <module>fcrc-customer</module>
        <module>fcrc-risk</module>
        <module>fcrc-compliance</module>
        <module>fcrc-case</module>
        <module>fcrc-report</module>
        <module>fcrc-workflow</module>
        <module>fcrc-agent</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 微服务与注册中心 -->
        <spring-cloud.version>2025.0.0</spring-cloud.version>
        <spring-cloud-alibaba.version>2025.0.0.0</spring-cloud-alibaba.version>

        <!-- AI 编排与智能体 -->
        <spring-ai-alibaba.version>1.1.2.4-security-fix</spring-ai-alibaba.version>
        <agentscope.version>2.0.4</agentscope.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-bom</artifactId>
                <version>${agentscope.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.fcrc</groupId>
                <artifactId>fcrc-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-graph-core</artifactId>
                <version>${spring-ai-alibaba.version}</version>
            </dependency>
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-harness</artifactId>
                <version>${agentscope.version}</version>
            </dependency>
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-extensions-model-dashscope</artifactId>
                <version>${agentscope.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <argLine>-Dfile.encoding=UTF-8</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
